# Database (Neon PostgreSQL with SSL required)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# App Security
SECRET_KEY=change_this_to_a_long_random_secret_key_minimum_32_characters
ENVIRONMENT=production
ALLOWED_ORIGINS=https://hr-assessment.onrender.com

# Default Seed Credentials (for initial setup script)
DEFAULT_MONITOR_CODE=HR_MONITOR_01
DEFAULT_MONITOR_NAME=Chief Exam Proctor
DEFAULT_MONITOR_PIN=654321

DEFAULT_ADMIN_CODE=HR_ADMIN_01
DEFAULT_ADMIN_NAME=HR Operations Lead
DEFAULT_ADMIN_PIN=987123

# Assessment Settings
EXAM_DURATION_MINUTES=60
TOTAL_MARKS=100
MARKS_PER_QUESTION=2

# WebRTC STUN / TURN
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional AI Analysis (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Port (Render injects PORT)
PORT=8000
